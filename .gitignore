# Files git should not track: caches, virtual envs, local scratch. Do NOT ignore out/, because the generated deliverables are committed.
.venv/
__pycache__/
.ipynb_checkpoints/

# sweep, null and perturbation partitions: regenerated by make sweep (tens of MB)
out/runs/
# evaluator cache: frozen null / perturbed exports and the method re-runs built from them (hundreds of MB)
out/eval_cache/
