{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hierarchy.schema.json",
  "$comment": "JSON Schema for out/<cutoff>/hierarchy.json (6a.1). One file per snapshot. Super-node levels are 0..levels-1 (0 = coarsest); the finest level K = levels is implicit: every snapshot node is its own leaf, whose parent is the level-(K-1) super-node containing it. Structural rules (laminarity, coverage, budgets, cutoff) are checked by validate.py, not by this schema.",
  "type": "object",
  "required": ["cutoff", "levels", "budgets", "supernodes"],
  "properties": {
    "cutoff": {"type": "integer", "description": "snapshot: content published <= this year"},
    "levels": {"type": "integer", "minimum": 1, "description": "number of super-node levels"},
    "budgets": {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 1,
                "description": "N_k used for this run; must equal the run config"},
    "supernodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "level", "parent_id", "member_ids", "label", "gloss"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "level": {"type": "integer", "minimum": 0},
          "parent_id": {"type": ["string", "null"], "minLength": 1},
          "member_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
          "label": {"type": ["string", "null"]},
          "gloss": {"type": ["string", "null"]}
        }
      }
    }
  }
}
